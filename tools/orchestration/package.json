{
  "name": "@bindforge/orchestration",
  "version": "1.0.0",
  "type": "module",
  "description": "CLI that drives a running OpenCode server through the @opencode/client SDK: create a session, send a prompt, and print the validated reply",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "start": "tsx src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "precheck": "npm install",
    "check": "npm run lint && npm run format:check && npm run test",
    "pipeline": "tsx src/pipeline/cli.ts"
  },
  "keywords": [
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@opencode/client": "^2.1.4",
    "yargs": "^17.7.3",
    "zod": "^4.6.7"
  }
}
